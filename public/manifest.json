{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "version": "0.3.1",
  "default_locale": "en",
  "action": {
    "default_title": "__MSG_extensionName__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "history",
    "scripting",
    "activeTab",
    "alarms",
    "storage"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "__MSG_commandOpenPopup__"
    },
    "regroup-current-window": {
      "suggested_key": {
        "default": "Ctrl+Shift+G",
        "mac": "Alt+Shift+G"
      },
      "description": "__MSG_commandOrganizeTabs__"
    },
    "deduplicate-tabs": {
      "suggested_key": {
        "default": "Ctrl+Shift+X",
        "mac": "Alt+Shift+D"
      },
      "description": "__MSG_commandDeduplicateTabs__"
    },
    "open-command-search": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "__MSG_commandOpenSearch__"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
